# ZEROSYS Sales Copilot - ローカルサーバー設定 (apps/server が読む)
# このファイルをコピーして .env を作成する。.env は Git 管理外。
# APIキーはバックエンドの環境変数にだけ置く。拡張機能やログに出さない (SPEC §14)。
# APIキーを置いただけで有料の長時間テストが自動開始することはない (SPEC §15)。

# --- STT (Deepgram) ---
# 空なら STT は not_configured として表示され、外部送信しない。
DEEPGRAM_API_KEY=
# モデルIDと言語は公式資料で確認のうえ設定 (SPEC §7-1)。
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ja
# 発話終了とみなす無音 (ms)。false で無効 (API 既定 10ms)。
DEEPGRAM_ENDPOINTING_MS=300
# UtteranceEnd の待ち時間 (ms, 公式最小 1000)。off で無効。
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=false

# --- 助言生成 (Claude API) ---
# 空なら助言は not_configured として表示され、外部送信しない。
ANTHROPIC_API_KEY=
# 自動カード（発言ごと。速さ優先）用のモデル
ANTHROPIC_MODEL=claude-haiku-5-5
# 手動ボタン（切り返し・次に聞く・次の約束・クロージング）用のモデル。押したときだけ呼ぶので質を優先。
ANTHROPIC_MANUAL_MODEL=claude-sonnet-5-5
# low / medium / high / none (none = effort を送らない)
ANTHROPIC_EFFORT=low
# 1回の生成のタイムアウト (ms)
ADVICE_TIMEOUT_MS=6000
# 手動ボタン1回の生成のタイムアウト (ms)。手動用モデルは自動用より遅いので長め。
ADVICE_MANUAL_TIMEOUT_MS=15000
# 不正JSON・タイムアウト等の再試行回数 (最大 3)。超えたら「確認してお伝えする」へ安全に切替。
ADVICE_MAX_RETRIES=1

# --- ローカルサーバー ---
# 127.0.0.1 以外へ bind しない (SPEC §14)。
HOST=127.0.0.1
PORT=8787
# 1 にすると 127.0.0.1 以外への bind を許可する。通常は空のまま (使わない)。
ALLOW_NON_LOOPBACK=
# 接続を許可する拡張機能 ID を固定する場合だけ設定 (chrome://extensions に表示される32文字)。空ならペアリングした拡張を許可。
ALLOWED_EXTENSION_ID=
# ペアリングコードの有効期限 (ms) と誤入力の上限回数。
PAIRING_CODE_TTL_MS=600000
PAIRING_MAX_ATTEMPTS=5
# ペアリングの有効期限 (日)。使うたびに延長されるので、毎日使えば切れない。空なら 180。
# ペアリング記録 (トークンのハッシュのみ) は本人用フォルダに保存され、サーバーや PC を再起動しても残る。
# (旧設定 SESSION_TOKEN_TTL_MS は使わなくなりました。.env に残っていても無視されます)
SESSION_TOKEN_TTL_DAYS=
# 本人用フォルダ (ペアリング記録・pnpm pair 用の秘密・自動起動時のログ)。空なら Windows は %LOCALAPPDATA%\ZEROSYS-SalesCopilot
USER_DATA_DIR=
# 自動起動時のログファイル (本人用フォルダからの相対/絶対)。自動起動の仕組みが設定する。手で起動するときは空のまま。
LOG_FILE=
# 承認済み条件の SQLite と、終了時に本人が選んだ場合だけ書く振り返りファイルの置き場所 (ワークスペース直下からの相対/絶対)。
DATA_DIR=data
EXPORT_DIR=exports
# 通常ログのレベル (会話本文・顧客名・キーは出さない)。
LOG_LEVEL=info

# --- 助言スケジューラー (SPEC §8) ---
# 自動助言のクールダウン (ms)
ADVICE_COOLDOWN_MS=6000
# この時間を超えたカードは現行推奨から外し「参考」扱い (ms)
ADVICE_STALE_MS=8000
# 手動ボタンの最小間隔 (ms)。過負荷防止。
ADVICE_MANUAL_MIN_INTERVAL_MS=1500
# 会話状態の直近ウィンドウ (ms, 60000〜120000)
CONVERSATION_WINDOW_MS=90000

# --- 音声・セッション ---
# 1系統あたりの STT 未送信音声の上限 (ms)。超えた古い音声は破棄して欠落区間として記録。
AUDIO_MAX_QUEUE_MS=2000
# 終了後に振り返りデータをメモリに残す時間 (ms)。0 なら終了と同時に消去。
SESSION_RETENTION_MS=600000
# 使用量 (usage) を画面へ送る間隔 (ms)
USAGE_INTERVAL_MS=5000

# --- OFFLINE テスト (API キー不要) ---
# 既定で再生する架空会話 (空なら名前順の先頭)。拡張の開始画面でも選べる。
OFFLINE_SCRIPT=
# 再生速度 (1 = 実時間)
OFFLINE_REPLAY_SPEED=1
# 1 にすると、OFFLINE でも開始画面で本人が選んだ場合だけ Claude を使える (キーが必要・架空会話を外部送信・有料)。
OFFLINE_USE_ANTHROPIC=

# --- セッション上限 (SPEC §15) ---
# 80% で警告、100% で新規外部処理を停止する。空欄は上限なし。
SESSION_MAX_STT_SECONDS=7200
SESSION_MAX_LLM_CALLS=400
SESSION_MAX_LLM_INPUT_TOKENS=2000000
SESSION_MAX_LLM_OUTPUT_TOKENS=200000
# 金額上限は価格表を設定した場合のみ有効 (PRICE_CURRENCY の通貨)。
SESSION_MAX_COST=

# --- 価格表 (任意) ---
# 未設定なら金額は推測せず使用量のみ表示する。設定する場合は出典と確認日を必ず書く。
# 通貨は1つだけ (混ぜない)。
PRICE_CURRENCY=
PRICE_SOURCE=
PRICE_CHECKED_DATE=
PRICE_STT_PER_MINUTE=
PRICE_LLM_INPUT_PER_MTOK=
PRICE_LLM_OUTPUT_PER_MTOK=
# 手動ボタン用モデル (ANTHROPIC_MANUAL_MODEL) の単価。自動用と別のモデルなのに空だと、手動ボタンを使った時点で金額は表示しない (推測しない)。
# 同じモデルを使う設定なら空のままで上の単価を使う。
PRICE_LLM_MANUAL_INPUT_PER_MTOK=
PRICE_LLM_MANUAL_OUTPUT_PER_MTOK=

# --- 自動テスト専用 (通常は書かない) ---
# PAIRING_CODE_FOR_TEST=123456 は NODE_ENV=test のときだけ有効。それ以外で設定されているとサーバーは起動しない。
