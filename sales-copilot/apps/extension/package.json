{
  "name": "@sales-copilot/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.worklet.config.ts && vite build -c vite.content.config.ts --mode meet-page && vite build -c vite.content.config.ts --mode meet-content && node scripts/check-dist.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-meet-popup.mjs"
  },
  "dependencies": {
    "@sales-copilot/contracts": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "vite": "7.3.8",
    "ws": "^8.23.0"
  }
}
