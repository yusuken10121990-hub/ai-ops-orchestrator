{
  "name": "zerosys-sales-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "ZEROSYS Sales Copilot - 商談中カンペAI (pnpm workspace root)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup:first": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm --filter @sales-copilot/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
